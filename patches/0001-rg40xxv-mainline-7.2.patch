+{
+	struct snd_soc_component *component =
+		snd_soc_dapm_to_component(w->dapm);
+	unsigned int mask = BIT(SUN50I_H616_LMUTE) |
+			    BIT(SUN50I_H616_RMUTE) |
+			    BIT(SUN50I_H616_RSWITCH) |
+			    BIT(SUN50I_H616_RAMPEN);
+	unsigned int value = 0;
+	int ret;
+
+	if (SND_SOC_DAPM_EVENT_ON(event))
+		value = BIT(SUN50I_H616_LMUTE) |
+			BIT(SUN50I_H616_RMUTE) |
+			BIT(SUN50I_H616_RAMPEN);
+
+	ret = snd_soc_component_update_bits(component,
+					    SUN50I_H616_DAC_AC_DAC_REG,
+					    mask, value);
+	if (ret < 0)
+		return ret;
+
+	dev_info(component->dev,
+		 "RG40AUDIO: lineout event=%#x DAC_REG=%#x\n", event,
+		 snd_soc_component_read(component,
+					SUN50I_H616_DAC_AC_DAC_REG));
+
+	return 0;
+}
