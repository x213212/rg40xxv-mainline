+	model = "Anbernic RG40XX V";
+	compatible = "anbernic,rg40xx-V", "allwinner,sun50i-h700";
+	rocknix-dt-id = "sun50i-h700-anbernic-rg40xx-v";
+};
+
+/*
+ * Claim the H700 TCON LCD compatible.
+ *
+ * sun4i_tcon.c carries sun50i_h700_lcd_quirks with dclk_min_div = 6 and
+ * clk_delay_max = 31, and an of_match entry for
+ * "allwinner,sun50i-h700-tcon-lcd", but this board never declared that
+ * string, so the driver fell back to sun50i_h616_lcd_quirks: dclk_min_div
+ * 1 and no clk_delay_max, which defaults to 30.
+ *
+ * Measured against the running vendor kernel on this device:
+ *   TCON0_CTL stock 0x800001f0 (CLK_DELAY 31) vs ours 0x800001e0 (30).
+ * The quirks comment states the H700 needs tcon_div >= 6 with all four RGB
+ * dot-clock phases on, and that a smaller divider still produces a picture
+ * but not the functional clock the display-engine input path expects -
+ * which is what a washed out, barely legible console looks like.
+ */
+&tcon_lcd0 {
+	compatible = "allwinner,sun50i-h700-tcon-lcd",
+		     "allwinner,sun50i-h616-tcon-lcd",
+		     "allwinner,sun8i-r40-tcon-lcd";
+};
+
+&joypad {
+	amux-count = <4>;
+	pwms = <&pwm 3 1000000 0>;
+	pinctrl-0 = <&joy_mux_pin>, <&pwm3_pin>;
+};
+
+&uart5 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart5_ph_pins>;
+	status = "okay";
+};
+
+&leds {
+	led-rgb {
+		function = LED_FUNCTION_KBD_BACKLIGHT;
+		color = <LED_COLOR_ID_RGB>;
+		gpios = <&pio 8 7 GPIO_ACTIVE_HIGH>; /* PI7 */
+	};
+};
+
+&panel {
+	compatible = "anbernic,rg40xx-panel", "panel-mipi-dpi-spi";
+};
