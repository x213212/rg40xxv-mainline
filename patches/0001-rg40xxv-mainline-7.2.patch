@@ -282,7 +282,18 @@
 
 	watchdog_init_timeout(&sunxi_wdt->wdt_dev, timeout, dev);
 	watchdog_set_nowayout(&sunxi_wdt->wdt_dev, nowayout);
-	watchdog_set_restart_priority(&sunxi_wdt->wdt_dev, 128);
+	/*
+	 * The RG40XX V vendor firmware advertises PSCI SYSTEM_RESET but never
+	 * completes the call in the RAM-boot environment.  PSCI registers at
+	 * priority 129, so the generic priority 128 watchdog fallback is never
+	 * reached and reboot hangs after devices have already been shut down.
+	 * Keep this quirk board-specific; other H616-family boards retain the
+	 * normal handler ordering.
+	 */
+	if (of_machine_is_compatible("anbernic,rg40xx-V"))
+		watchdog_set_restart_priority(&sunxi_wdt->wdt_dev, 130);
+	else
+		watchdog_set_restart_priority(&sunxi_wdt->wdt_dev, 128);
 
 	watchdog_set_drvdata(&sunxi_wdt->wdt_dev, sunxi_wdt);
 
