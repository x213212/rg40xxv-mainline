diff -ruN a/drivers/gpu/drm/sun4i/sun8i_rdma.c b/drivers/gpu/drm/sun4i/sun8i_rdma.c
--- a/drivers/gpu/drm/sun4i/sun8i_rdma.c	1970-01-01 08:00:00.000000000 +0800
+++ b/drivers/gpu/drm/sun4i/sun8i_rdma.c	2026-08-27 17:18:46.268926421 +0800
@@ -0,0 +1,583 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Copyright (C) Jernej Skrabec <jernej.skrabec@gmail.com>
+ */
+
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/list.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+
+#include "sun8i_rdma.h"
+
+#define SUN8I_RCQ_STATUS_OFFSET	0x0c
+#define SUN8I_RCQ_STATUS_FINISH	BIT(2)
+#define SUN8I_RCQ_STATUS_ACCEPT	BIT(3)
+#define SUN8I_RCQ_STATUS_W1C	(BIT(0) | GENMASK(3, 2))
+#define SUN8I_RCQ_HEAD_LOW_OFFSET	0x04
+#define SUN8I_RCQ_HEAD_HIGH_OFFSET	0x08
+#define SUN8I_RCQ_HEAD_LEN_OFFSET	0x0c
+
+/* Two frame periods at the lowest supported refresh rate. */
+#define SUN8I_RCQ_FINISH_TIMEOUT_US	40000
+
+struct sun8i_rcq_head {
+	u32 low_addr;
+	u32 len_hi;
+	u32 dirty;
+	u32 reg_offset;
+};
+
+struct sun8i_rdma_unit {
+	struct list_head node;
+	void __iomem *base;
+	void *mem;
+	void *staged;
+	void *rcq_mem;
+	dma_addr_t rcq_dma;
+	size_t rcq_size;
+	u32 reg_offset;
+	u32 size;
+	const struct reg_region *regions;
+	unsigned int first_head;
+	unsigned int deferred_enable_reg;
+	u32 deferred_enable_mask;
+	bool dirty;
+	bool deferred_enable_dirty;
+	bool staged_dirty;
+	bool staged_enable_dirty;
+	bool has_deferred_enable;
+};
+
+struct sun8i_rdma {
+	struct device *dev;
+	struct list_head list;
+	void __iomem *rcq;
+	struct sun8i_rcq_head *heads;
+	dma_addr_t heads_dma;
+	unsigned int head_count;
+	unsigned int head_alloc;
+	bool rcq_enabled;
+	bool rcq_ready;
+	bool rcq_armed;
+	/* Direct-register (no-RCQ) staging, shared with the vblank IRQ. */
+	spinlock_t lock;
+	bool pending;
+	unsigned long stage_count;
+	unsigned long flush_count;
+	u64 next_seq;
+	u64 pending_seq;
+	u64 flushed_seq;
+};
+
+/*
+ * Firmware can leave an armed DE33 RCQ and a head pointing into its former
+ * memory behind across a warm Fastboot boot, and a kernel that died with the
+ * queue armed leaves exactly the same wreckage behind for its successor. When
+ * Linux uses direct register writes, that stale queue must never be fetched:
+ * it can overwrite a complete modeset after the panel has already lit, which
+ * presents as one valid flash followed by a black scanout.
+ *
+ * Disable fetching first, then remove the stale descriptor and retire any
+ * pending W1C status. This is deliberately limited to DE33's no-RCQ mode.
+ *
+ * Run at bind so we never inherit someone else's queue, and again at shutdown
+ * so we never hand ours on. It touches only MMIO and takes no locks, so it is
+ * safe from the shutdown path.
+ */
+static void sun8i_rdma_quiesce_rcq(struct device *dev, void __iomem *rcq,
+				   bool rcq_enabled, const char *when)
+{
+	u32 status;
+
+	if (!rcq || rcq_enabled)
+		return;
+
+	writel(0, rcq);
+	readl(rcq);
+	writel(0, rcq + SUN8I_RCQ_HEAD_LOW_OFFSET);
+	writel(0, rcq + SUN8I_RCQ_HEAD_HIGH_OFFSET);
+	writel(0, rcq + SUN8I_RCQ_HEAD_LEN_OFFSET);
+	writel(SUN8I_RCQ_STATUS_W1C, rcq - SUN8I_RCQ_STATUS_OFFSET);
+	readl(rcq - SUN8I_RCQ_STATUS_OFFSET);
+
+	status = readl(rcq - SUN8I_RCQ_STATUS_OFFSET);
+	dev_info(dev,
+		 "DE33 no-RCQ %s: update=%#x head=%#x/%#x len=%#x status=%#x commit-mode=vblank-irq-flush\n",
+		 when, readl(rcq), readl(rcq + SUN8I_RCQ_HEAD_LOW_OFFSET),
+		 readl(rcq + SUN8I_RCQ_HEAD_HIGH_OFFSET),
+		 readl(rcq + SUN8I_RCQ_HEAD_LEN_OFFSET), status);
+}
+
+void sun8i_rdma_quiesce(struct sun8i_rdma *rdma)
+{
+	if (!rdma)
+		return;
+
+	sun8i_rdma_quiesce_rcq(rdma->dev, rdma->rcq, rdma->rcq_enabled,
+			       "shutdown");
+}
+
+struct sun8i_rdma *sun8i_rdma_init(struct device *dev,
+				   void __iomem *rcq, bool rcq_enabled)
+{
+	struct sun8i_rdma *rdma;
+
+	rdma = kzalloc_obj(*rdma, GFP_KERNEL);
+	if (!rdma)
+		return NULL;
+
+	rdma->dev = dev;
+	rdma->rcq = rcq;
+	rdma->rcq_enabled = rcq_enabled;
+	INIT_LIST_HEAD(&rdma->list);
+	spin_lock_init(&rdma->lock);
+
+	sun8i_rdma_quiesce_rcq(dev, rcq, rcq_enabled, "handoff");
+
+	return rdma;
+}
+
+void sun8i_rdma_deinit(struct sun8i_rdma *rdma)
+{
+	struct sun8i_rdma_unit *unit, *tmp;
+
+	if (!rdma)
+		return;
+
+	if (rdma->heads)
+		dma_free_coherent(rdma->dev,
+				  rdma->head_alloc * sizeof(*rdma->heads),
+				  rdma->heads, rdma->heads_dma);
+
+	list_for_each_entry_safe(unit, tmp, &rdma->list, node) {
+		list_del(&unit->node);
+		if (rdma->rcq_enabled)
+			dma_free_coherent(rdma->dev, unit->rcq_size,
+					  unit->rcq_mem, unit->rcq_dma);
+		kfree(unit->staged);
+		kfree(unit->mem);
+		kfree(unit);
+	}
+
+	kfree(rdma);
+}
+
+int sun8i_rdma_prepare(struct sun8i_rdma *rdma)
+{
+	struct sun8i_rdma_unit *unit;
+	unsigned int count = 0;
+
+	if (!rdma->rcq_enabled || rdma->rcq_ready)
+		return 0;
+
+	list_for_each_entry(unit, &rdma->list, node) {
+		const struct reg_region *region = unit->regions;
+
+		while (region->count) {
+			count++;
+			region++;
+		}
+	}
+
+	/* The hardware fetches RCQ heads in pairs. */
+	rdma->head_alloc = ALIGN(count, 2);
+	rdma->heads = dma_alloc_coherent(rdma->dev,
+					 rdma->head_alloc * sizeof(*rdma->heads),
+					 &rdma->heads_dma, GFP_KERNEL);
+	if (!rdma->heads)
+		return -ENOMEM;
+	memset(rdma->heads, 0, rdma->head_alloc * sizeof(*rdma->heads));
+
+	count = 0;
+	list_for_each_entry(unit, &rdma->list, node) {
+		const struct reg_region *region = unit->regions;
+		size_t offset = 0;
+
+		unit->first_head = count;
+		while (region->count) {
+			struct sun8i_rcq_head *head = &rdma->heads[count++];
+			dma_addr_t addr = unit->rcq_dma + offset;
+
+			head->low_addr = lower_32_bits(addr);
+			head->len_hi = region->count * sizeof(u32) |
+				       (upper_32_bits(addr) << 24);
+			head->reg_offset = unit->reg_offset + region->offset;
+			offset += ALIGN(region->count * sizeof(u32), 32);
+			region++;
+		}
+	}
+	rdma->head_count = count;
+
+	writel(lower_32_bits(rdma->heads_dma), rdma->rcq + 0x4);
+	writel(upper_32_bits(rdma->heads_dma), rdma->rcq + 0x8);
+	writel(rdma->head_alloc * sizeof(*rdma->heads), rdma->rcq + 0xc);
+	rdma->rcq_ready = true;
+
+	return 0;
+}
+
+/* Wait until a previously triggered queue fetch was consumed. */
+void sun8i_rdma_sync(struct sun8i_rdma *rdma)
+{
+	u32 status;
+	int ret;
+
+	if (!rdma->rcq_enabled || !rdma->rcq_armed)
+		return;
+
+	ret = readl_poll_timeout(rdma->rcq - SUN8I_RCQ_STATUS_OFFSET, status,
+				 status & SUN8I_RCQ_STATUS_FINISH,
+				 10, SUN8I_RCQ_FINISH_TIMEOUT_US);
+	if (ret)
+		dev_warn(rdma->dev, "RCQ sync timed out\n");
+	rdma->rcq_armed = false;
+}
+
+/* Copy dirty shadow units into the staging area.  Caller holds rdma->lock. */
+static u64 sun8i_rdma_stage_locked(struct sun8i_rdma *rdma)
+{
+	struct sun8i_rdma_unit *unit;
+	bool any = false;
+
+	list_for_each_entry(unit, &rdma->list, node) {
+		if (!unit->dirty)
+			continue;
+		memcpy(unit->staged, unit->mem, unit->size);
+		unit->staged_dirty = true;
+		if (unit->deferred_enable_dirty)
+			unit->staged_enable_dirty = true;
+		unit->dirty = false;
+		unit->deferred_enable_dirty = false;
+		any = true;
+	}
+	if (any) {
+		rdma->pending = true;
+		rdma->pending_seq = ++rdma->next_seq;
+		rdma->stage_count++;
+	}
+
+	return rdma->pending ? rdma->pending_seq : rdma->flushed_seq;
+}
+
+/*
+ * Write the staged units to the live registers.  Caller holds rdma->lock.
+ *
+ * Registered enable words are treated as a transaction boundary:
+ *   1. publish real enable-state transitions first (a plain page flip
+ *      changes addresses but not enable bits, so it never pulses an
+ *      already-enabled layer or blender route off);
+ *   2. publish every non-enable word;
+ *   3. publish enables in reverse unit order, which enables layers and the
+ *      formatter before the blender pipe that makes them visible.
+ */
+static void sun8i_rdma_write_staged_locked(struct sun8i_rdma *rdma)
+{
+	struct sun8i_rdma_unit *unit;
+
+	list_for_each_entry(unit, &rdma->list, node) {
+		u32 value;
+
+		if (!unit->staged_dirty || !unit->has_deferred_enable ||
+		    !unit->staged_enable_dirty)
+			continue;
+		value = *(u32 *)(unit->staged + unit->deferred_enable_reg);
+		writel(value & ~unit->deferred_enable_mask,
+		       unit->base + unit->deferred_enable_reg);
+		readl(unit->base + unit->deferred_enable_reg);
+	}
+	wmb();
+
+	list_for_each_entry(unit, &rdma->list, node) {
+		const struct reg_region *region;
+
+		if (!unit->staged_dirty)
+			continue;
+
+		for (region = unit->regions; region->count; region++) {
+			unsigned int i;
+
+			for (i = 0; i < region->count; i++) {
+				unsigned int reg = region->offset + i * sizeof(u32);
+
+				if (unit->has_deferred_enable &&
+				    unit->staged_enable_dirty &&
+				    reg == unit->deferred_enable_reg)
+					continue;
+				writel(*(u32 *)(unit->staged + reg),
+				       unit->base + reg);
+			}
+		}
+	}
+	wmb();
+
+	list_for_each_entry_reverse(unit, &rdma->list, node) {
+		u32 value;
+
+		if (!unit->staged_dirty || !unit->has_deferred_enable ||
+		    !unit->staged_enable_dirty)
+			continue;
+		value = *(u32 *)(unit->staged + unit->deferred_enable_reg);
+		if (value & unit->deferred_enable_mask)
+			writel(value, unit->base + unit->deferred_enable_reg);
+	}
+	wmb();
+
+	list_for_each_entry(unit, &rdma->list, node) {
+		unit->staged_dirty = false;
+		unit->staged_enable_dirty = false;
+	}
+}
+
+int sun8i_rdma_apply(struct sun8i_rdma *rdma, bool defer, u64 *sequence)
+{
+	struct sun8i_rdma_unit *unit;
+	bool dirty = false;
+	unsigned long flags;
+	unsigned int i;
+	u64 seq = 0;
+
+	if (sequence)
+		*sequence = 0;
+
+	if (rdma->rcq_enabled) {
+		if (WARN_ON(!rdma->rcq_ready))
+			return -EINVAL;
+
+		/*
+		 * The queue may be fetched only once per update. Triggering
+		 * a new update before the previous one was consumed can
+		 * lose it entirely, leaving the hardware scanning out stale
+		 * buffer addresses. Wait for the previous fetch and fall
+		 * back to CPU writes if it never happened, like the vendor
+		 * driver does.
+		 */
+		if (rdma->rcq_armed) {
+			u32 status;
+			int ret;
+
+			ret = readl_poll_timeout(rdma->rcq - SUN8I_RCQ_STATUS_OFFSET,
+						 status,
+						 status & SUN8I_RCQ_STATUS_FINISH,
+						 10, SUN8I_RCQ_FINISH_TIMEOUT_US);
+			rdma->rcq_armed = false;
+			if (ret) {
+				dev_warn(rdma->dev,
+					 "RCQ not consumed, syncing registers with CPU\n");
+				writel(0, rdma->rcq);
+				writel(SUN8I_RCQ_STATUS_W1C,
+				       rdma->rcq - SUN8I_RCQ_STATUS_OFFSET);
+				list_for_each_entry(unit, &rdma->list, node) {
+					const struct reg_region *region;
+
+					for (region = unit->regions; region->count; region++)
+						__iowrite32_copy(unit->base + region->offset,
+							 unit->mem + region->offset,
+							 region->count);
+					unit->dirty = false;
+					unit->deferred_enable_dirty = false;
+				}
+				return 0;
+			}
+		}
+
+		/*
+		 * Gate queue fetches while the head list and staging
+		 * memory are inconsistent, and retire the dirty flags of
+		 * the consumed update so a spurious refetch applies
+		 * nothing.
+		 */
+		writel(0, rdma->rcq);
+		writel(SUN8I_RCQ_STATUS_W1C,
+		       rdma->rcq - SUN8I_RCQ_STATUS_OFFSET);
+		for (i = 0; i < rdma->head_count; i++)
+			rdma->heads[i].dirty = 0;
+
+		list_for_each_entry(unit, &rdma->list, node) {
+			const struct reg_region *region;
+			unsigned int head;
+			size_t offset = 0;
+
+			if (!unit->dirty)
+				continue;
+
+			head = unit->first_head;
+			for (region = unit->regions; region->count; region++) {
+				memcpy(unit->rcq_mem + offset,
+				       unit->mem + region->offset,
+				       region->count * sizeof(u32));
+				rdma->heads[head++].dirty = 1;
+				offset += ALIGN(region->count * sizeof(u32), 32);
+			}
+			unit->dirty = false;
+			unit->deferred_enable_dirty = false;
+			dirty = true;
+		}
+
+		if (dirty) {
+			dma_wmb();
+			writel(1, rdma->rcq);
+			rdma->rcq_armed = true;
+		}
+
+		return 0;
+	}
+
+	/*
+	 * Direct-register DE33 path.  DE33 has no DE2/DE3 GLOBAL_DBUFF latch:
+	 * a CPU write to a layer address, size or enable register is live for
+	 * the remainder of the frame currently being scanned out.  Writing a
+	 * page flip while the panel is mid-frame therefore shows the old
+	 * buffer above the write point and the new buffer below it (visible
+	 * tearing on RG40XX V).  The vendor no-RCQ driver avoids this by
+	 * writing its register cache from the LCD vblank interrupt.
+	 *
+	 * Copy the dirty shadow state into a staging area here and let
+	 * sun8i_rdma_flush_pending(), called from the TCON vblank interrupt,
+	 * publish it during vertical blanking, before the DE starts fetching
+	 * the next frame.  Callers that cannot wait for a vblank (modeset,
+	 * disable) flush the staging area immediately instead.
+	 */
+	spin_lock_irqsave(&rdma->lock, flags);
+	seq = sun8i_rdma_stage_locked(rdma);
+	if (!defer && rdma->pending) {
+		sun8i_rdma_write_staged_locked(rdma);
+		rdma->pending = false;
+		rdma->flushed_seq = rdma->pending_seq;
+		seq = rdma->flushed_seq;
+	}
+	if (sequence)
+		*sequence = seq;
+	spin_unlock_irqrestore(&rdma->lock, flags);
+
+	return 0;
+}
+
+/*
+ * Publish a staged update from the vblank interrupt.  Returns the sequence
+ * that reached hardware, or zero when there was no pending transaction.
+ */
+u64 sun8i_rdma_flush_pending(struct sun8i_rdma *rdma)
+{
+	unsigned long flags;
+	u64 flushed = 0;
+
+	if (!rdma || rdma->rcq_enabled)
+		return 0;
+
+	spin_lock_irqsave(&rdma->lock, flags);
+	if (rdma->pending) {
+		sun8i_rdma_write_staged_locked(rdma);
+		rdma->pending = false;
+		rdma->flushed_seq = rdma->pending_seq;
+		rdma->flush_count++;
+		flushed = rdma->flushed_seq;
+	}
+	spin_unlock_irqrestore(&rdma->lock, flags);
+
+	return flushed;
+}
+
+struct sun8i_rdma_unit *
+sun8i_rdma_add_unit(struct sun8i_rdma *rdma, void __iomem *base,
+		    u32 reg_offset, unsigned int size,
+		    const struct reg_region *regions)
+{
+	struct sun8i_rdma_unit *unit;
+	const struct reg_region *region;
+
+	unit = kzalloc_obj(*unit, GFP_KERNEL);
+	if (!unit)
+		return NULL;
+
+	unit->mem = kzalloc(size, GFP_KERNEL);
+	if (!unit->mem) {
+		kfree(unit);
+		return NULL;
+	}
+
+	if (!rdma->rcq_enabled) {
+		unit->staged = kzalloc(size, GFP_KERNEL);
+		if (!unit->staged) {
+			kfree(unit->mem);
+			kfree(unit);
+			return NULL;
+		}
+	}
+
+	if (rdma->rcq_enabled) {
+		/* Every RCQ source block must start at a 32-byte boundary. */
+		for (region = regions; region->count; region++)
+			unit->rcq_size += ALIGN(region->count * sizeof(u32), 32);
+
+		unit->rcq_mem = dma_alloc_coherent(rdma->dev, unit->rcq_size,
+						   &unit->rcq_dma, GFP_KERNEL);
+		if (!unit->rcq_mem) {
+			kfree(unit->staged);
+			kfree(unit->mem);
+			kfree(unit);
+			return NULL;
+		}
+	}
+
+	unit->base = base;
+	unit->reg_offset = reg_offset;
+	unit->size = size;
+	unit->regions = regions;
+	list_add_tail(&unit->node, &rdma->list);
+
+	return unit;
+}
+
+void sun8i_rdma_write(struct sun8i_rdma_unit *unit,
+		      unsigned int reg, u32 value)
+{
+	u32 *ptr = unit->mem + reg;
+	u32 old;
+
+	WARN_ON(reg + sizeof(*ptr) > unit->size);
+	old = *ptr;
+	if (old == value)
+		return;
+	*ptr = value;
+	unit->dirty = true;
+	if (unit->has_deferred_enable && reg == unit->deferred_enable_reg &&
+	    ((old ^ value) & unit->deferred_enable_mask))
+		unit->deferred_enable_dirty = true;
+}
+
+void sun8i_rdma_memcpy(struct sun8i_rdma_unit *unit, unsigned int reg,
+		       const u32 *values, unsigned int count)
+{
+	u32 *dst = unit->mem + reg;
+	unsigned int deferred_index;
+
+	WARN_ON(reg + count * sizeof(*values) > unit->size);
+	if (!memcmp(dst, values, count * sizeof(*values)))
+		return;
+	if (unit->has_deferred_enable &&
+	    unit->deferred_enable_reg >= reg &&
+	    unit->deferred_enable_reg < reg + count * sizeof(*values)) {
+		deferred_index = (unit->deferred_enable_reg - reg) / sizeof(u32);
+		if ((dst[deferred_index] ^ values[deferred_index]) &
+		    unit->deferred_enable_mask)
+			unit->deferred_enable_dirty = true;
+	}
+
+	memcpy(dst, values, count * sizeof(*values));
+	unit->dirty = true;
+}
+
+void sun8i_rdma_defer_enable(struct sun8i_rdma_unit *unit,
+			     unsigned int reg, u32 enable_mask)
+{
+	if (WARN_ON(!unit || !enable_mask || reg % sizeof(u32) ||
+		    reg + sizeof(u32) > unit->size))
+		return;
+
+	unit->deferred_enable_reg = reg;
+	unit->deferred_enable_mask = enable_mask;
+	unit->has_deferred_enable = true;
+}
