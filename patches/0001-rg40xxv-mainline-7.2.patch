+void sun8i_csc_config_rgb_identity(struct sun8i_layer *layer)
+{
+	/*
+	 * DE33's vendor pipeline enables a channel CSC even for RGB-to-RGB.
+	 * The first three words are D0..D2, followed by the 3x4 matrix.
+	 * 0x20000 is unity in the DE33 coefficient format.
+	 */
+	static const u32 identity[15] = {
+		0, 0, 0,
+		0x00020000, 0, 0, 0,
+		0, 0x00020000, 0, 0,
+		0, 0, 0x00020000, 0,
+	};
