#!/usr/bin/env bash
set -euo pipefail

# Privileged Bluetooth helper for the RG40XX V UI.
#
# The adapter is an RTL8821CS combo part sharing silicon with the SDIO Wi-Fi
# side.  At boot the SDIO half is still coming up when hci_uart_h5 probes the
# UART child, so the H5 link sync fails and no hci0 appears even though the
# driver bound; rg40xxv-bt-rebind.service handles that separately.  Once hci0
# exists the RTL firmware loads normally and everything here works.
#
# Every tool path is fixed, every argument is validated, and no caller-supplied
# string ever reaches a shell.  Addresses are the only free-form input and are
# constrained to a strict MAC pattern before use.

SAFE_PATH=/usr/sbin:/usr/bin:/sbin:/bin
PATH=$SAFE_PATH
LC_ALL=C
export PATH LC_ALL

SNAPSHOT_HEADER=$'RG40XXV_BLUETOOTH_SNAPSHOT\t1'
MAX_DEVICES=16
SCAN_SECONDS=6

die() {
	printf 'rg40xxv-bluetooth-control: %s\n' "$*" >&2
	exit 1
}

usage() {
	printf '%s\n' \
		"用法：$0 status" \
		"      $0 power {on|off}" \
		"      $0 scan" \
		"      $0 pair ADDRESS" \
		"      $0 connect ADDRESS" \
		"      $0 disconnect ADDRESS" \
		"      $0 forget ADDRESS" >&2
	exit 2
}

init_tools() {
	local test_root
	root_prefix=
	if [[ ${DEVICE_CONTROL_TESTING:-0} == 1 ]]; then
		test_root=${DEVICE_CONTROL_TEST_ROOT:-}
		[[ $test_root == /tmp/rg40xxv-device-control-test.* ]] || \
			die '測試根目錄不符合固定 /tmp 前綴'
		[[ -d $test_root/rootfs && ! -L $test_root/rootfs ]] || \
			die '無效測試 rootfs'
		[[ -d $test_root/mock-bin && ! -L $test_root/mock-bin ]] || \
			die '無效測試工具目錄'
		root_prefix=$test_root/rootfs
		bluetoothctl=$test_root/mock-bin/bluetoothctl
		rfkill=$test_root/mock-bin/rfkill
		tool_env=(env -i PATH="$SAFE_PATH" LC_ALL=C \
			DEVICE_CONTROL_TESTING=1 DEVICE_CONTROL_TEST_ROOT="$test_root")
	else
		bluetoothctl=/usr/bin/bluetoothctl
		rfkill=/usr/sbin/rfkill
		tool_env=(env -i PATH="$SAFE_PATH" LC_ALL=C)
	fi
	for tool in "$bluetoothctl" "$rfkill"; do
		[[ -f $tool && ! -L $tool && -x $tool ]] || \
			die "固定工具不可用：$tool"
	done
	adapter_dir=$root_prefix/sys/class/bluetooth/hci0
}

# bluetoothctl is interactive by nature; -- forces one-shot mode and the
# timeout bounds a hung adapter so the UI worker never blocks on us.
bt() {
	timeout 10 "${tool_env[@]}" "$bluetoothctl" "$@" 2>/dev/null || true
}

require_address() {
	local address=$1
	[[ $address =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || \
		die '位址格式不符合 MAC'
	printf '%s' "${address^^}"
}

adapter_present() {
	[[ -d $adapter_dir ]]
}

adapter_powered() {
	bt show | grep -qE '^\s*Powered:\s*yes$'
}

emit_status() {
	local present=no powered=no
	adapter_present && present=yes
	if [[ $present == yes ]] && adapter_powered; then
		powered=yes
	fi
	printf '%s\n' "$SNAPSHOT_HEADER"
	printf 'adapter\t%s\t%s\n' "$present" "$powered"
	[[ $powered == yes ]] || return 0

	# One line per device: address, paired, connected, trusted, name.
	# Name is last because it is the only field that may contain spaces.
	local line address name info paired connected trusted count=0
	while IFS= read -r line; do
		[[ $line =~ ^Device\ ([0-9A-F:]{17})\ (.*)$ ]] || continue
		address=${BASH_REMATCH[1]}
		name=${BASH_REMATCH[2]}
		# Strip control characters; the UI renders this straight into a
		# texture and must never be handed escape sequences.
		name=${name//[$'\t\r\n']/ }
		info=$(bt info "$address")
		paired=no; connected=no; trusted=no
		grep -qE '^\s*Paired:\s*yes$'    <<<"$info" && paired=yes
		grep -qE '^\s*Connected:\s*yes$' <<<"$info" && connected=yes
		grep -qE '^\s*Trusted:\s*yes$'   <<<"$info" && trusted=yes
		printf 'device\t%s\t%s\t%s\t%s\t%s\n' \
			"$address" "$paired" "$connected" "$trusted" "$name"
		count=$((count + 1))
		((count < MAX_DEVICES)) || break
	done < <(bt devices)
}

init_tools
command=${1:-}
case $command in
	status)
		(($# == 1)) || usage
		emit_status
		;;
	power)
		(($# == 2)) || usage
		case $2 in
			on|off) ;;
			*) usage ;;
		esac
		adapter_present || die '找不到 hci0'
		"${tool_env[@]}" "$rfkill" unblock bluetooth >/dev/null 2>&1 || true
		bt power "$2" >/dev/null
		emit_status
		;;
	scan)
		(($# == 1)) || usage
		adapter_present || die '找不到 hci0'
		# scan on returns immediately in one-shot mode, so hold the
		# discovery window open explicitly, then report what was found.
		timeout "$SCAN_SECONDS" "${tool_env[@]}" "$bluetoothctl" \
			--timeout "$SCAN_SECONDS" scan on >/dev/null 2>&1 || true
		emit_status
		;;
	pair|connect|disconnect|forget)
		(($# == 2)) || usage
		adapter_present || die '找不到 hci0'
		address=$(require_address "$2")
		case $command in
			pair)
				bt pair "$address" >/dev/null
				bt trust "$address" >/dev/null
				bt connect "$address" >/dev/null
				;;
			connect)    bt connect "$address" >/dev/null ;;
			disconnect) bt disconnect "$address" >/dev/null ;;
			forget)     bt remove "$address" >/dev/null ;;
		esac
		emit_status
		;;
	*)
		usage
		;;
esac
