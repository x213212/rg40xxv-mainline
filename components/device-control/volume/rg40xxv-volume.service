[Unit]
Description=RG40XX V resident system volume controller
Documentation=file:/usr/share/doc/rg40xxv-device-control/README-zh-TW.md
After=sound.target systemd-tmpfiles-setup.service

[Service]
Type=simple
ExecStart=/usr/libexec/rg40xxv/rg40xxv-volume-daemon
Restart=always
RestartSec=500ms
RuntimeDirectory=rg40xxv-volume rg40xxv-ui
RuntimeDirectoryMode=0750
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
SystemCallArchitectures=native
ReadWritePaths=/run/rg40xxv-volume /run/rg40xxv-ui /mnt/data/rg40xxv/state/audio
LimitNOFILE=32
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
