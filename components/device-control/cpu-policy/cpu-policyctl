#!/usr/bin/env bash
set -euo pipefail

die() {
    printf 'cpu-policyctl: %s\n' "$*" >&2
    exit 1
}

init_paths() {
    root_prefix=
    if [[ ${DEVICE_CONTROL_TESTING:-0} == 1 ]]; then
        test_root=${DEVICE_CONTROL_TEST_ROOT:-}
        [[ "$test_root" == /tmp/rg40xxv-device-control-test.* ]] || \
            die '測試根目錄不符合固定 /tmp 前綴'
        [[ -d "$test_root/rootfs" && ! -L "$test_root/rootfs" ]] || \
            die '無效測試 rootfs'
        root_prefix="$test_root/rootfs"
    fi
    cpufreq_root="${root_prefix}/sys/devices/system/cpu/cpufreq"
    nvmem_root="${root_prefix}/sys/bus/nvmem/devices"
    run_dir="${root_prefix}/run/rg40xxv/cpu-policy"
    sleep_snapshot="$run_dir/sleep-governors.v1"
}

discover_policies() {
    local path name
    POLICIES=()
    [[ -d "$cpufreq_root" ]] || die 'cpufreq sysfs 不存在'
    for path in "$cpufreq_root"/policy*; do
        [[ -d "$path" && ! -L "$path" ]] || continue
        name=$(basename -- "$path")
        [[ $name =~ ^policy[0-9]+$ ]] || continue
        POLICIES+=("$path")
    done
    ((${#POLICIES[@]} > 0)) || die '找不到 cpufreq policy'
}

word_present() {
    local needle=$1 word
    for word in $2; do
        [[ $word == "$needle" ]] && return 0
    done
    return 1
}

read_policy() {
    local policy=$1 governors current frequencies value
    [[ -f "$policy/scaling_available_governors" && ! -L "$policy/scaling_available_governors" ]] || return 1
    [[ -f "$policy/scaling_governor" && ! -L "$policy/scaling_governor" ]] || return 1
    [[ -f "$policy/scaling_available_frequencies" && ! -L "$policy/scaling_available_frequencies" ]] || return 1
    governors=$(<"$policy/scaling_available_governors")
    current=$(<"$policy/scaling_governor")
    frequencies=$(<"$policy/scaling_available_frequencies")
    word_present schedutil "$governors" || return 1
    word_present powersave "$governors" || return 1
    word_present performance "$governors" || return 1
    word_present "$current" "$governors" || return 1
    for value in $frequencies; do
        [[ $value =~ ^[0-9]{5,10}$ ]] || return 1
    done
    [[ -n "$frequencies" ]] || return 1
    printf '%s\t%s\t%s\n' "$current" "$governors" "$frequencies"
}

efuse_status() {
    local directory name
    [[ -d "$nvmem_root" ]] || { printf 'not-exposed'; return; }
    for directory in "$nvmem_root"/*; do
        [[ -d "$directory" ]] || continue
        name=$(basename -- "$directory")
        case "$name" in
            *efuse*|*sid*|*SID*)
                [[ -e "$directory/nvmem" ]] && { printf 'exposed-not-read'; return; }
                ;;
        esac
    done
    printf 'not-exposed'
}

validate_all() {
    local policy data failed=0
    discover_policies
    for policy in "${POLICIES[@]}"; do
        if data=$(read_policy "$policy"); then
            printf 'OK %s %s\n' "$(basename -- "$policy")" "${data%%$'\t'*}"
        else
            printf 'INVALID %s：缺少 governor 或公開 OPP\n' "$(basename -- "$policy")" >&2
            failed=1
        fi
    done
    printf 'efuse=%s\n' "$(efuse_status)"
    ((failed == 0)) || return 1
}

write_governor() {
    local policy=$1 governor=$2 name fail_policy
    name=$(basename -- "$policy")
    [[ -f "$policy/scaling_governor" && ! -L "$policy/scaling_governor" && -w "$policy/scaling_governor" ]] || return 1
    if [[ ${RESTORE_PHASE:-0} == 1 ]]; then
        fail_policy=${CPU_POLICY_TEST_FAIL_RESTORE_POLICY:-}
    else
        fail_policy=${CPU_POLICY_TEST_FAIL_POLICY:-}
    fi
    if [[ ${DEVICE_CONTROL_TESTING:-0} == 1 && $fail_policy == "$name" && ${FAIL_USED:-0} == 0 ]]; then
        FAIL_USED=1
        return 1
    fi
    printf '%s' "$governor" >"$policy/scaling_governor"
    [[ $(<"$policy/scaling_governor") == "$governor" ]]
}

set_all_governors() {
    local governor=$1 policy data available
    FAIL_USED=0
    discover_policies
    for policy in "${POLICIES[@]}"; do
        data=$(read_policy "$policy") || die "無效 policy：$(basename -- "$policy")"
        available=${data#*$'\t'}
        available=${available%%$'\t'*}
        word_present "$governor" "$available" || die "policy 不支援 $governor"
    done
    for policy in "${POLICIES[@]}"; do
        write_governor "$policy" "$governor" || return 1
    done
}

status_all() {
    local policy data current governors frequencies
    discover_policies
    for policy in "${POLICIES[@]}"; do
        data=$(read_policy "$policy") || die "無效 policy：$(basename -- "$policy")"
        IFS=$'\t' read -r current governors frequencies <<<"$data"
        printf '%s governor=%s governors=%s opp_khz=%s\n' \
            "$(basename -- "$policy")" "$current" "$governors" "$frequencies"
    done
    printf 'efuse=%s\n' "$(efuse_status)"
    printf 'overclock=disabled\n'
    printf 'cpu_hotplug_writes=disabled\n'
}

snapshot_governors() {
    local policy data current related
    SNAPSHOT=$(mktemp "$run_dir/.governors.XXXXXX")
    for policy in "${POLICIES[@]}"; do
        data=$(read_policy "$policy") || return 1
        current=${data%%$'\t'*}
        related=$(<"$policy/related_cpus")
        [[ $related =~ ^[0-9]+(\ [0-9]+)*$ ]] || return 1
        printf '%s\t%s\t%s\n' "$(basename -- "$policy")" "$current" \
            "$related" >>"$SNAPSHOT"
    done
    chmod 0600 "$SNAPSHOT"
}

validate_snapshot_file() {
    local snapshot=$1 name governor related current_related policy data available count=0
    local -A seen=()

    [[ -f "$snapshot" && ! -L "$snapshot" ]] || return 1
    discover_policies
    while IFS=$'\t' read -r name governor related; do
        [[ $name =~ ^policy[0-9]+$ ]] || return 1
        [[ $governor =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || return 1
        [[ $related =~ ^[0-9]+(\ [0-9]+)*$ ]] || return 1
        [[ -z ${seen[$name]+x} ]] || return 1
        seen[$name]=1
        policy="$cpufreq_root/$name"
        [[ -d "$policy" && ! -L "$policy" ]] || return 1
        data=$(read_policy "$policy") || return 1
        [[ -f "$policy/related_cpus" && ! -L "$policy/related_cpus" ]] || return 1
        current_related=$(<"$policy/related_cpus")
        [[ $current_related == "$related" ]] || return 1
        available=${data#*$'\t'}
        available=${available%%$'\t'*}
        word_present "$governor" "$available" || return 1
        count=$((count + 1))
    done <"$snapshot"
    ((count > 0)) || return 1
}

set_snapshot_governors() {
    local snapshot=$1 governor=$2 name saved related policy data available result=0

    validate_snapshot_file "$snapshot" || return 1
    FAIL_USED=0
    RESTORE_PHASE=0
    while IFS=$'\t' read -r name saved related; do
        policy="$cpufreq_root/$name"
        data=$(read_policy "$policy") || { result=1; continue; }
        available=${data#*$'\t'}
        available=${available%%$'\t'*}
        word_present "$governor" "$available" || { result=1; continue; }
        write_governor "$policy" "$governor" || result=1
    done <"$snapshot"
    return "$result"
}

restore_governors_file() {
    local snapshot=$1 name governor related policy result=0

    validate_snapshot_file "$snapshot" || return 1
    FAIL_USED=0
    RESTORE_PHASE=1
    while IFS=$'\t' read -r name governor related; do
        policy="$cpufreq_root/$name"
        write_governor "$policy" "$governor" || result=1
    done <"$snapshot"
    RESTORE_PHASE=0
    return "$result"
}

restore_governors() {
    [[ -f ${SNAPSHOT:-} ]] || return 0
    if restore_governors_file "$SNAPSHOT"; then
        rm -f -- "$SNAPSHOT"
        SNAPSHOT=
        return 0
    fi
    return 1
}

sleep_enter() {
    local tmp policy data related

    discover_policies
    if [[ -e "$sleep_snapshot" || -L "$sleep_snapshot" ]]; then
        validate_snapshot_file "$sleep_snapshot" ||
            die '既有 sleep governor 快照損壞'
    else
        tmp=$(mktemp "$run_dir/.sleep-governors.XXXXXX")
        SNAPSHOT=$tmp
        for policy in "${POLICIES[@]}"; do
            data=$(read_policy "$policy") || {
                rm -f -- "$tmp"
                SNAPSHOT=
                die "無效 policy：$(basename -- "$policy")"
            }
            related=$(<"$policy/related_cpus")
            [[ $related =~ ^[0-9]+(\ [0-9]+)*$ ]] || {
                rm -f -- "$tmp"
                SNAPSHOT=
                die "policy CPU topology 無效：$(basename -- "$policy")"
            }
            printf '%s\t%s\t%s\n' "$(basename -- "$policy")" \
                "${data%%$'\t'*}" "$related" >>"$tmp"
        done
        chmod 0600 "$tmp"
        mv -f -- "$tmp" "$sleep_snapshot"
        SNAPSHOT=
    fi
    if ! set_snapshot_governors "$sleep_snapshot" powersave; then
        if restore_governors_file "$sleep_snapshot" >/dev/null 2>&1; then
            rm -f -- "$sleep_snapshot"
            die '切換 powersave 失敗，已還原原 governor'
        fi
        die '切換 powersave 失敗且無法完整還原；快照已保留'
    fi
    printf 'governor=powersave\n'
}

sleep_exit() {
    if [[ ! -e "$sleep_snapshot" && ! -L "$sleep_snapshot" ]]; then
        printf 'governor=unchanged\n'
        return 0
    fi
    if ! restore_governors_file "$sleep_snapshot"; then
        set_snapshot_governors "$sleep_snapshot" powersave >/dev/null 2>&1 || true
        die '無法還原 sleep 前 governor；快照已保留'
    fi
    rm -f -- "$sleep_snapshot"
    printf 'governor=restored\n'
}

run_performance() {
    local child_rc restore_rc=0
    (($# > 0)) || die 'run-performance 缺少命令'
    discover_policies
    snapshot_governors || die '無法建立 governor 快照'
    restore_on_signal() {
        local signal_rc=$1
        trap - HUP INT TERM
        restore_governors || true
        exit "$signal_rc"
    }
    trap 'restore_on_signal 129' HUP
    trap 'restore_on_signal 130' INT
    trap 'restore_on_signal 143' TERM
    # Arm restoration before the first governor write.  Otherwise a TERM that
    # lands after policy0 becomes performance but before policy4 is written (or
    # before these traps were installed) can terminate the wrapper with a
    # partially switched system and no cleanup.
    if ! set_all_governors performance; then
        trap - HUP INT TERM
        restore_governors || true
        die '切換 performance 失敗，已嘗試還原'
    fi
    set +e
    "$@"
    child_rc=$?
    set -e
    trap - HUP INT TERM
    restore_governors || restore_rc=$?
    ((restore_rc == 0)) || die '遊戲結束但 governor 還原失敗'
    return "$child_rc"
}

set_ui_default() {
    discover_policies
    snapshot_governors || die '無法建立 governor 快照'
    if ! set_all_governors schedutil; then
        restore_governors || true
        die '設定 schedutil 失敗，已嘗試還原'
    fi
    rm -f -- "$SNAPSHOT"
    SNAPSHOT=
}

init_paths
mkdir -p -- "$run_dir"
chmod 0700 "$run_dir"
exec 9>"$run_dir/.lock"
if ! flock -x -w 1 -E 75 9; then
	printf '%s\n' 'cpu-policyctl: governor policy lock timed out after 1 second' >&2
	exit 75
fi
SNAPSHOT=

case ${1:-} in
    validate)
        (($# == 1)) || die 'validate 不接受額外參數'
        validate_all
        ;;
    status)
        (($# == 1)) || die 'status 不接受額外參數'
        status_all
        ;;
    ui-default)
        (($# == 1)) || die 'ui-default 不接受額外參數'
        set_ui_default
        printf 'governor=schedutil\n'
        ;;
    lock-idle)
        (($# == 1)) || die 'lock-idle 不接受額外參數'
        sleep_enter
        printf 'frequency_cap=unchanged\nruntime_idle=delegated-to-kernel\n'
        ;;
    unlock-idle)
        (($# == 1)) || die 'unlock-idle 不接受額外參數'
        sleep_exit
        ;;
    run-performance)
        [[ ${2:-} == -- ]] || die '固定語法為 run-performance -- <命令>'
        shift 2
        run_performance "$@"
        ;;
    *)
        printf '用法：%s {validate|status|ui-default|lock-idle|unlock-idle}\n' "$0" >&2
        printf '      %s run-performance -- <命令與參數...>\n' "$0" >&2
        exit 2
        ;;
esac
